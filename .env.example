# ==============================================================================
# TALK-TO-PDF ROOT ENVIRONMENT CONFIGURATION
# Copy to .env or configure in your deployment platform (Vercel / Container Host)
# DO NOT COMMIT REAL SECRETS TO REPOSITORY
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Next.js / Vercel)
# ------------------------------------------------------------------------------
# Clerk Authentication (Public)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk Authentication (Secret - optional if using server middleware)
CLERK_SECRET_KEY=sk_test_...

# Backend API URL (Points to your deployed Express backend)
# Local: http://localhost:5000
# Production: https://api.yourdomain.com (or https://talktopdf-backend.onrender.com)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# BACKEND & WORKER CONFIGURATION (Express / BullMQ / Container Host)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# Frontend Origin for CORS (Must be exact production frontend origin)
# Local: http://localhost:3000
# Production: https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:3000

# Clerk Backend Authentication
# Required for token verification on protected endpoints
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Google Gemini API Key
# Used for embeddings (models/gemini-embedding-001) and chat (gemini-1.5-flash)
GOOGLE_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash

# Redis / Valkey URL
# Local: redis://localhost:6379
# Managed (Upstash/Aiven): rediss://default:password@host:port
REDIS_URL=redis://localhost:6379

# Qdrant Vector Database
# Local: http://localhost:6333
# Qdrant Cloud: https://xyz-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
# Qdrant API Key (Required for Qdrant Cloud clusters, leave blank for local without auth)
QDRANT_API_KEY=
QDRANT_COLLECTION=pdf_documents

# Upload Limits & Rate Limiting
MAX_FILE_SIZE_MB=50
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_REQUESTS=100
