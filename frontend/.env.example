# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES
# Place in frontend/.env.local or configure in Vercel project settings
# ==============================================================================

# Clerk Authentication (Publishable Key for Client-side React)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk Secret Key (Required for Clerk Next.js Server Middleware)
CLERK_SECRET_KEY=sk_test_...

# Backend API Base URL (Must point to deployed Express API, no trailing slash)
# Local: http://localhost:5000
# Production: https://talktopdf-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
