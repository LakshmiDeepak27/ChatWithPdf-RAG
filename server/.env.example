# ==============================================================================
# BACKEND & WORKER ENVIRONMENT VARIABLES
# Place in server/.env or configure in container environment
# ==============================================================================

PORT=5000
NODE_ENV=production

# Allowed Frontend Origin for CORS
# Local: http://localhost:3000
# Production: https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:3000

# Clerk Authentication (Backend secret key required for token verification)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Google Gemini API
GOOGLE_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash

# Redis / Valkey Connection
# Local: redis://localhost:6379
# Cloud (Upstash / Aiven / Render): rediss://default:token@host:port
REDIS_URL=redis://localhost:6379

# Qdrant Vector Store
# Local: http://localhost:6333
# Cloud: https://xyz.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=pdf_documents

# Upload and Security Configuration
MAX_FILE_SIZE_MB=50
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_REQUESTS=100
